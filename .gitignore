# dependencies (reinstalled with `npm install`)
node_modules/

# electron-builder output (installers are built in CI, never committed)
/dist/

# C-10.1: the packaged build's commit sha, written by build.yml (or scripts/ensure-build-sha.js locally)
# right before electron-builder packages the app — never checked in, or every source checkout would claim
# to be whatever commit last ran a local `npm run dist:*`.
/build-sha.txt

# live session state — ephemeral; may contain personal paths / session names / cost
/runtime/

# Playwright E2E harness output (test/e2e/) — generated per run, never committed
/test-results/
/playwright-report/
/blob-report/

# logs (incl. electron-out.log / electron-err.log when launched via cmd)
*.log
/logs/

# debug captures / screenshots (root-level only; assets/ and renderer/ images are tracked)
/*.png
/debug/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# editor / IDE
.vscode/
.idea/
*.swp
*~

# temp debug log (live-join diagnostics)
.claudible-debug.log

# local audit / planning notes — kept on disk, never committed to the shared repo. These name internal
# findings (unfixed issues, owner decisions, CI/billing state) and are written for us, not for users.
#
# The globs below close the class rather than chasing each file: eleven explicit entries had accumulated and
# BETA-RELEASE-AUDIT.md STILL slipped through as untracked-but-not-ignored, one `git add -A` away from being
# published on a repo that is about to go public. All four are ROOT-ANCHORED (`/…`), so nothing under docs/
# is touched — docs/RELEASE-CHECKLIST.md, docs/OS-CONVERSION-PLAN.md and their siblings stay tracked — and
# .gitignore never affects an already-tracked file, so no existing file can disappear from the repo.
/*AUDIT*.md
/*-REPORT.md
/*FIX-*.md
/*-PLAN.md
/Finishline Audit for Security and Optimizations.md
/MASTER-FIX-LIST.md
/SECOND-AUDIT.md
/General Fix Audit.md
/FINAL-READINESS-AUDIT.md
/FINAL-PREPAREDNESS-AUDIT-PLAN.md
/FINAL-PREPAREDNESS-AUDIT.md
/MASTER-DEBUG-REPORT.md
/FINAL-DEBUG-OVERHAUL-REPORT.md
/MASTER-FIX-PLAN.md
/MASTER-IMPLEMENTATION-PLAN.md

# Claude Code runtime state injected by Claudible into the workspace
.claude/
