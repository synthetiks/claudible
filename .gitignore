# dependencies (reinstalled with `npm install`)
node_modules/

# electron-builder output (installers are built in CI, never committed)
/dist/

# live session state — ephemeral; may contain personal paths / session names / cost
/runtime/

# logs (incl. electron-out.log / electron-err.log when launched via cmd)
*.log
/logs/

# debug captures / screenshots (root-level only; assets/ and renderer/ images are tracked)
/*.png
/debug/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# editor / IDE
.vscode/
.idea/
*.swp
*~

# temp debug log (live-join diagnostics)
.claudible-debug.log

# local audit / planning notes — kept on disk, never committed to the shared repo
/Finishline Audit for Security and Optimizations.md
/MASTER-FIX-LIST.md
/SECOND-AUDIT.md
/General Fix Audit.md
/FINAL-READINESS-AUDIT.md
/FINAL-PREPAREDNESS-AUDIT-PLAN.md
/FINAL-PREPAREDNESS-AUDIT.md
/MASTER-DEBUG-REPORT.md
