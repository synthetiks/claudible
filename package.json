{
  "name": "claudible",
  "version": "0.7.0",
  "description": "Multiplayer cockpit for Claude Code: invite anyone into your live session to watch, talk, and co-drive. Fully-local push-to-talk voice, live telemetry, an agents cockpit, session history with one-click revert. Windows (WSL2 or native) · Linux · macOS.",
  "license": "MIT",
  "author": "the_crazydev",
  "homepage": "https://github.com/thecrazydev1/claudible#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thecrazydev1/claudible.git"
  },
  "bugs": {
    "url": "https://github.com/thecrazydev1/claudible/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-code-gui",
    "claude-code-ui",
    "gui",
    "cockpit",
    "voice-control",
    "voice",
    "hands-free",
    "speech-to-text",
    "text-to-speech",
    "whisper",
    "kokoro",
    "session-sharing",
    "live-share",
    "pair-programming",
    "collaboration",
    "electron",
    "wsl",
    "terminal",
    "tui"
  ],
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "setup": "wsl.exe -e bash setup/setup.sh",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "patch-package",
    "test": "node test/runner-parity.test.js && node test/posix-runner.test.js && node test/win-runner.test.js && node test/history.test.js && node test/identity.test.js && node test/history-store.test.js && node test/checkpoint.test.js && node test/checkpoint-tool.test.js && node test/share-names.test.js && node test/presence-filter.test.js && node test/live-holder.test.js && node test/context-hook.test.js && node test/tabs-share.test.js && node test/adopt-workspace.test.js && bash test/sessions-divergence.test.sh && bash test/diff-commits.test.sh && bash test/hooks-parity.sh && bash test/port-parity.sh",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "42.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.4",
    "patch-package": "^8.0.0"
  },
  "build": {
    "appId": "dev.thecrazydev.claudible",
    "productName": "Claudible",
    "copyright": "Copyright © 2026 the_crazydev",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "hooks/**/*",
      "runners/**/*",
      "wsl/**/*",
      "share/**/*",
      "setup/**/*",
      "launch/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.md",
      "!docs/**/*",
      "!test/**/*",
      "!runtime/**/*",
      "!**/*.log",
      "!**/.git*",
      "!**/.DS_Store",
      "!**/*.{o,obj,gyp,gypi}",
      "!**/node_modules/.cache/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/claudible.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Claudible",
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "synopsis": "Desktop cockpit for Claude Code: live telemetry, local push-to-talk voice, live co-work.",
      "maintainer": "the_crazydev <noreply@users.noreply.github.com>",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": null
  }
}
