{
  "name": "claudible",
  "version": "0.9.4",
  "description": "Multiplayer cockpit for Claude Code: invite anyone into your live session to watch, talk, and co-drive. Fully-local push-to-talk voice, live telemetry, an agents cockpit, session history with one-click revert. Windows (WSL2 or native) \u00b7 Linux \u00b7 macOS.",
  "license": "MIT",
  "author": "the_crazydev",
  "homepage": "https://github.com/synthetiks/claudible#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synthetiks/claudible.git"
  },
  "bugs": {
    "url": "https://github.com/synthetiks/claudible/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-code-gui",
    "claude-code-ui",
    "gui",
    "cockpit",
    "voice-control",
    "voice",
    "hands-free",
    "speech-to-text",
    "text-to-speech",
    "whisper",
    "kokoro",
    "session-sharing",
    "live-share",
    "pair-programming",
    "collaboration",
    "electron",
    "wsl",
    "terminal",
    "tui"
  ],
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preinstall": "node scripts/preinstall-check.js",
    "start": "electron .",
    "lint": "eslint .",
    "test:e2e": "node test/e2e-boot.test.js",
    "setup": "wsl.exe -e bash setup/setup.sh",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "patch-package",
    "test": "node test/run-all.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "npm install --no-save node-pty-prebuilt-multiarch@^0.10.1-pre.5 && electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "42.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.4",
    "patch-package": "^8.0.0"
  },
  "build": {
    "appId": "dev.thecrazydev.claudible",
    "productName": "Claudible",
    "copyright": "Copyright \u00a9 2026 the_crazydev",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "hooks/**/*",
      "runners/**/*",
      "wsl/**/*",
      "share/**/*",
      "setup/**/*",
      "launch/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.md",
      "!docs/**/*",
      "!test/**/*",
      "!runtime/**/*",
      "!**/*.log",
      "!**/.git*",
      "!**/.DS_Store",
      "!**/*.{o,obj,gyp,gypi}",
      "!**/node_modules/.cache/**",
      "LICENSE",
      "THIRD-PARTY-LICENSES.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/claudible.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Claudible",
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "synopsis": "Desktop cockpit for Claude Code: live telemetry, local push-to-talk voice, live co-work.",
      "maintainer": "the_crazydev <noreply@users.noreply.github.com>",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": null
  }
}
