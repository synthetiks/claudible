{
  "name": "claudible",
  "version": "0.2.0",
  "description": "A cockpit for Claude Code: a sleek desktop interface with live telemetry, fully-local push-to-talk voice (talk and hear replies), and live co-work — invite someone into your running session by link. Windows + WSL2.",
  "license": "MIT",
  "author": "the_crazydev",
  "homepage": "https://github.com/thecrazydev1/claudible#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thecrazydev1/claudible.git"
  },
  "bugs": {
    "url": "https://github.com/thecrazydev1/claudible/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-code-gui",
    "claude-code-ui",
    "gui",
    "cockpit",
    "voice-control",
    "voice",
    "hands-free",
    "speech-to-text",
    "text-to-speech",
    "whisper",
    "kokoro",
    "session-sharing",
    "live-share",
    "pair-programming",
    "collaboration",
    "electron",
    "wsl",
    "terminal",
    "tui"
  ],
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "setup": "wsl.exe -e bash setup/setup.sh",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "42.4.0",
    "patch-package": "^8.0.0"
  }
}
